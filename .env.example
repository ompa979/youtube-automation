# ─── Cloudflare ───────────────────────────────────────────────────────────────
# Set these via `wrangler secret put` for production.
# For local dev, put them here and Wrangler will pick them up.

# ─── LLM (script generation) ──────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# Active AI image generation: Cloudflare Workers AI + FLUX.1 Schnell
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
IMAGE_PROVIDER=cloudflare
CLOUDFLARE_SCENE_IMAGES_ENABLED=true
CLOUDFLARE_SCENE_WIDTH=768
CLOUDFLARE_SCENE_HEIGHT=1365
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
CLOUDFLARE_IMAGE_STEPS=4
OPENROUTER_API_KEY=

# Optional high-quality Hindi neural TTS
# Put the Google service-account JSON here for local runs.
EDGE_TTS_VOICE=hi-IN-SwaraNeural

# ─── Visuals ──────────────────────────────────────────────────────────────────
PEXELS_API_KEY=
PIXABAY_API_KEY=

# ─── YouTube upload (rotating projects) ───────────────────────────────────────
# Each value is a base64-encoded OAuth token JSON *with* refresh token.
# Generate with: python scripts/setup_oauth.py
YT_CREDS_1=
YT_CREDS_2=
YT_CREDS_3=
YT_CREDS_4=
YT_CREDS_5=
YT_CREDS_6=
YT_CREDS_7=
YT_CREDS_8=
YT_CREDS_9=
YT_CREDS_10=
YT_CREDS_11=
YT_CREDS_12=
YT_CREDS_13=
YT_CREDS_14=
YT_CREDS_15=
YT_CREDS_16=
YT_CREDS_17=
YT_CREDS_18=
YT_CREDS_19=
# Free TTS settings
TTS_PROVIDER=edge
TTS_LANGUAGE=hi-IN
TTS_VOICE=hi-IN-MadhurNeural,hi-IN-SwaraNeural
TTS_NO_FALLBACK=false

# Thumbnail AI — Cloudflare Workers AI + FLUX.1 Schnell
# Cloudflare's Workers AI free allocation currently allows 10,000 Neurons/day.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID_2=
CLOUDFLARE_API_TOKEN_2=
CLOUDFLARE_ACCOUNT_ID_3=
CLOUDFLARE_API_TOKEN_3=
CLOUDFLARE_ACCOUNT_ID_4=
CLOUDFLARE_API_TOKEN_4=
CLOUDFLARE_MAX_ACCOUNTS=4
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
CLOUDFLARE_SCENE_MODEL=@cf/black-forest-labs/flux-1-schnell
CLOUDFLARE_THUMBNAIL_MODEL=@cf/black-forest-labs/flux-2-klein-4b
CLOUDFLARE_IMAGE_STEPS=4
THUMBNAIL_VARIANTS=5

# Optional fallback for a self-hosted/generic image endpoint
THUMBNAIL_AI_URL=
THUMBNAIL_AI_TOKEN=
THUMBNAIL_AI_TIMEOUT=180

# Content mode: exam (existing) or viral (broad-audience Shorts)
CONTENT_MODE=exam
# Credential prefix: YT_CREDS for main channel pool; VIRAL_YT_CREDS for viral channel pool
YOUTUBE_CREDENTIAL_PREFIX=YT_CREDS
# Viral selection gate (0-100)
MIN_VIRAL_SCORE=62
# Optional additional Cloudflare scene/thumbnail failover accounts
CLOUDFLARE_ACCOUNT_ID_2=
CLOUDFLARE_API_TOKEN_2=
CLOUDFLARE_ACCOUNT_ID_3=
CLOUDFLARE_API_TOKEN_3=
CLOUDFLARE_ACCOUNT_ID_4=
CLOUDFLARE_API_TOKEN_4=
